{
  "name": "chtrs",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run tui/main.ts",
    "test": "bun test tui",
    "typecheck": "tsc --noEmit",
    "build": "bun run scripts/build.ts",
    "storybook": "bun run scripts/storybook.ts dev",
    "storybook:frames": "bun run scripts/render-stories.tsx",
    "build-storybook": "bun run storybook:frames && storybook build --disable-telemetry",
    "typecheck:storybook": "bun run storybook:frames && tsc --noEmit -p storybook/tsconfig.json",
    "test:storybook": "bun run scripts/storybook.ts test",
    "test:storybook:visual": "bun run scripts/storybook.ts test --visual",
    "test:storybook:visual:update": "bun run scripts/storybook.ts test --visual --update",
    "install:local": "bun run build && bun run scripts/install.ts"
  },
  "dependencies": {
    "@opentui/core": "0.5.17",
    "@opentui/react": "0.5.17",
    "react": "19.3.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@fontsource/jetbrains-mono": "5.3.0",
    "@storybook/addon-vitest": "10.3.6",
    "@storybook/react-vite": "10.3.6",
    "@types/bun": "1.4.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/browser-playwright": "4.1.9",
    "playwright": "1.57.0",
    "react-dom": "19.3.0",
    "storybook": "10.3.6",
    "typescript": "5.9.3",
    "vite": "7",
    "vitest": "4.1.9"
  }
}
