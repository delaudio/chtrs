{
  "compilerOptions": {
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "bun"
    ],
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "jsxImportSource": "@opentui/react"
  },
  "include": [
    "tui/**/*.ts",
    "tui/**/*.tsx",
    "scripts/**/*.ts",
    "scripts/**/*.tsx"
  ]
}
